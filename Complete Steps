Phase 6: Systemd Services Setup for DB2 & HADRExecute on ALL DB2 nodes to ensure automated DB2 and HADR startup upon server reboot:1. DB2 Engine Service (/etc/systemd/system/db2.service)Bashcat << 'EOF' | sudo tee /etc/systemd/system/db2.service
[Unit]
Description=IBM Db2 Instance Service for db2inst1
After=network.target network-online.target rsyslog.service
Wants=network-online.target

[Service]
Type=forking
User=db2inst1
Group=db2iadm1
Environment="DB2INSTANCE=db2inst1"
ExecStart=/bin/bash -lc "db2start"
ExecStop=/bin/bash -lc "db2stop"
TimeoutStartSec=300
TimeoutStopSec=300
RemainAfterExit=yes
KillMode=none

[Install]
WantedBy=multi-user.target
EOF
2. HADR Management Service (/etc/systemd/system/db2hadr.service)Bashcat << 'EOF' | sudo tee /etc/systemd/system/db2hadr.service
[Unit]
Description=IBM Db2 HADR Startup Service for db2inst1
After=network.target network-online.target rsyslog.service db2.service
Wants=network-online.target db2.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=db2inst1
Group=db2iadm1
Environment=DB2INSTANCE=db2inst1
ExecStart=/usr/local/bin/db2hadr_start.sh
ExecStop=/usr/local/bin/db2hadr_stop.sh

[Install]
WantedBy=multi-user.target
EOF
